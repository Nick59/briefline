# Docker: domain Traefik routes to this app, and the Traefik entrypoint to use.
# *.localhost resolves to this machine without a DNS entry. For HTTPS, use websecure and BRIEFLINE_SCHEME=https.
BRIEFLINE_DOMAIN=briefline.localhost
BRIEFLINE_ENTRYPOINT=web
BRIEFLINE_SCHEME=http

# SQLite file. Created on first start.
PM_DATABASE_PATH=data/project-manager.db

# When set, /api/* and /mcp require "Authorization: Bearer <token>", and the dashboard asks for it once.
PM_API_TOKEN=

# Public URL of the dashboard, used for links in ticket comments.
PM_PUBLIC_URL=http://localhost:5173

# Set to false to start with an empty database instead of the demo project.
PM_SEED_DEMO=true

# Optional: human briefs written by Claude instead of the offline rule-based translator.
ANTHROPIC_API_KEY=
PM_BRIEF_MODEL=claude-opus-5-5

# Encrypts the API keys saved on ticketing connections (AES-256-GCM). 32 bytes, base64 or hex.
# Generate with: openssl rand -base64 32
# Without it, API keys cannot be saved in the Ticketing menu. Losing it makes saved keys unreadable.
BRIEFLINE_SECRET_KEY=

# Optional fallback API keys, used by connections that have no key saved.
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=
PLANE_API_KEY=
PM_WEBHOOK_SECRET=

# Set to 1 to log every ticketing request (method, URL, status, duration). Failed requests are always logged.
BRIEFLINE_DEBUG_TICKETING=
