# SQLite file. Created on first start.
PM_DATABASE_PATH=data/project-manager.db

# When set, /api/* and /mcp require "Authorization: Bearer <token>", and the dashboard asks for it once.
PM_API_TOKEN=

# Public URL of the dashboard, used for links in ticket comments.
PM_PUBLIC_URL=http://localhost:5173

# Set to false to start with an empty database instead of the demo project.
PM_SEED_DEMO=true

# Optional: human briefs written by Claude instead of the offline rule-based translator.
ANTHROPIC_API_KEY=
PM_BRIEF_MODEL=claude-opus-5-5

# Ticketing credentials, read only from the environment.
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=
PM_WEBHOOK_SECRET=
